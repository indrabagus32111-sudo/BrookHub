    local base = nil
    local posInicial = nil
    local raiz = nil

    local function limparSofa()
        if loopTP then
            loopTP:Disconnect()
            loopTP = nil
        end

        if sofaEquipado then
            local boneco = eu.Character
            if boneco then
                local sofa = boneco:FindFirstChild("Couch")
                if sofa then
                    sofa.Parent = eu.Backpack
                    sofaEquipado = false
