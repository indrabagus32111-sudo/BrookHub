if type(_G.__VNHUB_LANG) ~= "string" then
    local savedLang = "EN"
    pcall(function()
        if type(isfile) == "function" and type(readfile) == "function" and isfile("VNHUB_SAE/lang.txt") then
            local raw = tostring(readfile("VNHUB_SAE/lang.txt") or ""):match("^%s*(.-)%s*$")
            if raw == "EN" or raw == "VI" then
                savedLang = raw
            end
        end
    end)
    _G.__VNHUB_LANG = savedLang
end

local function __VNHUB_TO_EN(s)
    if type(s) ~= "string" or s == "" then
        return s
    end
    local direct = __VNHUB_EN[s]
    if direct then
        return direct
    end
    local trimmed = s:match("^%s*(.-)%s*$")
    if trimmed and __VNHUB_EN[trimmed] then
        return __VNHUB_EN[trimmed]
    end
    local m1 = s:match("^Đang chạy %((.+)%)$")
    if m1 then
        return "Active (" .. __VNHUB_TO_EN(m1) .. ")"
    end
    m1 = s:match("^Đang chờ %((.+)%)$")
    if m1 then
        return "Waiting (" .. __VNHUB_TO_EN(m1) .. ")"
    end
    m1 = s:match("^Trộm: (.+)$")
    if m1 then
        return "Steal: " .. __VNHUB_TO_EN(m1)
    end
    m1 = s:match("^Chờ (.+)$")
    if m1 then
        return "Wait " .. m1
    end
    m1 = s:match("^Tiếp theo sau (.+)$")
    if m1 then
        return "Next in " .. m1
    end
    m1 = s:match("^Hồi chiêu (.+)$")
    if m1 then
        return "Cooldown " .. m1
    end
    m1 = s:match("^Đặt (.+)$")
    if m1 then
        return "Place " .. m1
    end
    m1 = s:match("^Cần (.+)$")
    if m1 then
        return "Need " .. m1
    end
    m1 = s:match("^Quét (.+)$")
    if m1 then
        return "Scan " .. m1
    end
    m1 = s:match("^Nạp (.+)$")
    if m1 then
        return "Feed " .. m1
    end
    m1 = s:match("^Còn ~(%d+)s$")
    if m1 then
        return "~" .. m1 .. "s left"
    end
    m1 = s:match("^(%d+) Drone trên sân$")
    if m1 then
        return m1 .. " Drone(s) in field"
    end
    local m1_2, m2 = s:match("^x([%d%.]+)  •  (.+)$")
    if m1_2 and m2 then
        return "x" .. m1_2 .. "  •  " .. __VNHUB_TO_EN(m2)
    end
    m1_2, m2 = s:match("^Bậc (%d+): (.+)$")
    if m1_2 and m2 then
        return "Tier " .. m1_2 .. ": " .. __VNHUB_TO_EN(m2)
    end
    m1 = s:match("^Tầng (%d+)$")
    if m1 then
        return "Floor " .. m1
    end
    m1_2, m2 = s:match("^Đã mở khóa (%d+)/(%d+)$")
    if m1_2 and m2 then
        return m1_2 .. " of " .. m2 .. " unlocked"
    end
    m1 = s:match("^Đang có (%d+)$")
    if m1 then
        return m1 .. " owned"
    end
    m1 = s:match("^(%d+) trứng$")
    if m1 then
        return m1 .. " egg(s)"
    end
    m1 = s:match("^(%d+) thú cưng$")
    if m1 then
        return m1 .. " pet(s)"
    end
    m1 = s:match("^(%d+) kết quả$")
    if m1 then
        return m1 .. " match(es)"
    end
    m1 = s:match("^Tự động tải hiện tại: (.+)$")
    if m1 then
        return "Current Auto-Load: " .. (m1 == "Không có" and "None" or m1)
    end
    return s
end

