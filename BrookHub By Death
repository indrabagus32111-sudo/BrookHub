local Players = game:GetService("Players")
local Stats = game:GetService("Stats")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/indrabagus32111-sudo/Project/refs/heads/main/Project"))()

local Window = Library:CreateWindow({
    Title = "Kenz Hub",
    Subtitle = "Violence District",
    SubtitleColor = Color3.fromRGB(255, 0, 0),
    Logo = "rbxassetid://133364772533215",
    LogoSize = 28,
    SphereText = false,
    SphereWords = "KH",
    SphereImage = "rbxassetid://133364772533215",
    SphereIconSize = 41
})

local cg = game:GetService("CoreGui")
local roots = { cg }
if type(gethui) == "function" then
    pcall(function() table.insert(roots, gethui()) end)
end
for _, r in ipairs(roots) do
    for _, child in ipairs(r:GetChildren()) do
        if child:IsA("ScreenGui") and (child.Name == "VNHUB_CustomUI" or child.Name == "VNHUB_GUI" or child.Name == "ToggleUIButton") then
            pcall(child.Destroy, child)
        end
    end
end

local infoTab = Window:MakeTab({"Info", "info"})

local ProfileSection = infoTab:AddSection({"Player Profile"})
local headshotUrl = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=420&h=420"
ProfileSection:AddProfile(headshotUrl, LocalPlayer.Name)

infoTab:AddSection({"Script Information"})
infoTab:AddParagraph({"Developer/Owner:", "Kenz & Death"})
infoTab:AddParagraph({"You are using:", "Kenz Hub Brookhaven🏡"})

local pingValue = "Unknown"
local netStats = Stats:FindFirstChild("Network")
local serverStats = netStats and netStats:FindFirstChild("ServerStatsItem")

if serverStats and serverStats:FindFirstChild("Data Ping") then
    pingValue = serverStats["Data Ping"]:GetValueString()
end

local executorName = "Unknown"
if identifyexecutor then
    local success, name, version = pcall(function() return identifyexecutor() end)
    if success then
        executorName = tostring(name) .. (version and (" v" .. tostring(version)) or "")
    end
end

infoTab:AddSection({"Player Information"})
infoTab:AddParagraph({"Username:", LocalPlayer.Name or "Unknown"})
infoTab:AddParagraph({"Display Name:", LocalPlayer.DisplayName or "Unknown"})
infoTab:AddParagraph({"User ID:", tostring(LocalPlayer.UserId) or "Unknown"})
infoTab:AddParagraph({"Account Age:", tostring(LocalPlayer.AccountAge) .. " days"})
infoTab:AddParagraph({"Ping:", pingValue})
infoTab:AddParagraph({"Executor:", executorName})

infoTab:AddSection({"Rejoin"})
infoTab:AddButton({"Rejoin", function()
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end})

